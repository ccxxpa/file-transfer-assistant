    "multer": "^2.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ccxxpa/file-transfer-assistant.git"
  }
